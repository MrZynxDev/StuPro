# Copie ce fichier en .env.local et remplis les valeurs (Supabase → Project Settings → API).
# Sans ces variables, l'app tourne en mode démo (données dans le navigateur uniquement).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Clé publique VAPID pour les notifications push (voir README : npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
